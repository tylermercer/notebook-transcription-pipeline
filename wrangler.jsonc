{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notebook-router-mcp",
  "main": "dist/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GITHUB_OWNER": "owner",
    "GITHUB_REPO": "notebook-router",
    "GITHUB_BASE_BRANCH": "main",
    "NOTEBOOK_PATH": "notebook.md"
  }
}
